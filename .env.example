# Flask runtime
FLASK_ENV=production
FLASK_SECRET_KEY=replace-with-random-secret

# Session cookie (cross-site frontend/backend)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=None

# Comma-separated list (no spaces)
# Include local dev origins and deployed frontend domain(s)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-frontend-domain.pages.dev

# Admin password hash
# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('9999'))"
#ADMIN_PASSWORD_HASH=pbkdf2:sha256:1000000$tvwz08rCogP0Cs5g$8aef9638396f0e72591b794d2eafc05dd90b736c7d7a94d588813ff17c486b3f
ADMIN_PASSWORD_HASH=scrypt:32768:8:1$emHPLfav9xcWn9uF$dc44ea3b6953a82756a8ab822bca2998fe98e717e0145723a9e9ea545f48b5b6cf3ddcc6ed71122edbc8a939c4aab35b39d6f99435f3f7207bb27ca1bcb4ca66
# Railway Postgres connection string
DATABASE_URL=

# Scheduler
ENABLE_SCHEDULED_REFRESH=true
